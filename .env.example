# ===== Google ADK / Gemini =====
AGENT_MODEL=gemini-2.5-flash
GEMINI_API_KEY=<tu-api-key-de-gemini>
GOOGLE_GENAI_USE_VERTEXAI=false
APP_LOG_LEVEL=INFO

# ===== Zoho =====
# Para cambiar de sandbox a production, reemplaza estos valores manualmente.
ZOHO_MCP_URL=<url-del-mcp-de-zoho>
ZOHO_ORG_ID=<org-id>
ZOHO_DEFAULT_DEPARTMENT_ID=
ZOHO_DESK_API_BASE=https://desk.zoho.com/api/v1

# Acciones de escritura en Zoho al cierre (comentario + correo + cerrar ticket).
# Apagado por defecto: el pipeline solo genera el HTML.
ZOHO_ACTIONS_ENABLED=false
# rest usa ZOHO_TOKEN_WEBHOOK_* / ZOHO_OAUTH_* contra Zoho Desk API.
# mcp usa ZOHO_MCP_URL y requiere que el server MCP tenga la conexión autorizada.
ZOHO_ACTIONS_TRANSPORT=rest
ZOHO_CLOSED_STATUS=Closed

# OAuth interno (preferido). Si se configuran las tres, el agente refresca el
# token dentro del proceso y el webhook n8n deja de usarse.
ZOHO_OAUTH_CLIENT_ID=
ZOHO_OAUTH_CLIENT_SECRET=
ZOHO_OAUTH_REFRESH_TOKEN=
ZOHO_ACCOUNTS_HOST=https://accounts.zoho.com

# OAuth vía webhook n8n (legado — migrar a ZOHO_OAUTH_*).
ZOHO_TOKEN_WEBHOOK_URL=<url-del-webhook-n8n>
ZOHO_TOKEN_WEBHOOK_USER=<usuario-basic-auth>
ZOHO_TOKEN_WEBHOOK_PASS=<password-basic-auth>

# ===== Servicios internos CUN =====
CUN_ADDITIONAL_FEES_URL=https://appzoho-stg.cunapp.pro/api/v1/adk/catalogos/additional-fees
CUN_COMPANY_PAYMENTS_URL=https://appzoho-stg.cunapp.pro/api/v1/adk/validaciones-financieras/company-payments
CUN_COMPANY_PAYMENTS_NIT_PARAM=nitEmpresa
CUN_SERVICES_AUTH_URL=https://appzoho-stg.cunapp.pro/api/v1/auth/login
CUN_SERVICES_USERNAME=<usuario-servicios-cun>
CUN_SERVICES_PASSWORD=<password-servicios-cun>
CUN_SERVICES_API_TOKEN=
CUN_SERVICES_TIMEOUT_SECONDS=15
CUN_SERVICES_VERIFY_SSL=false
